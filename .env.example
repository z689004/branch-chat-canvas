# 复制为 .env 后填写（后端启动时读取，可选；也可以直接在网页右上角「模型设置」里配置）

# 模型来源：mock（演示模式，默认）| openai（任何 OpenAI 兼容 API）| ollama（本地模型）
LLM_PROVIDER=mock

# 云端 API（DeepSeek / 豆包 / 通义 / OpenAI / 智谱 等，只要兼容 OpenAI 协议）
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
LLM_MODEL=deepseek-chat

# 本地 Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 服务端口（默认 8000）
PORT=8000
